<Project>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Tests.Unit'))">
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- Testing -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
        <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
        <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
        
        <!-- Test utilities -->
        <PackageVersion Include="FakeItEasy" Version="9.0.1" />
        <PackageVersion Include="Bogus" Version="35.6.5" />

        <!-- Other shared dependencies -->
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    </ItemGroup>
</Project>